ARG PYTHON_BASE=public.ecr.aws/docker/library/python:3.12-slim
FROM ${PYTHON_BASE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt .
COPY deploy/wheels/ /wheels/
RUN cd /wheels && sha256sum -c SHA256SUMS && cd /app && pip install --no-cache-dir --no-index --find-links=/wheels --only-binary=:all: -r requirements.txt && rm -rf /wheels && useradd --uid 10001 --create-home app && mkdir -p /data/attachments && chown -R app:app /data/attachments /app
COPY --chown=app:app backend/ .
USER app
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1","--proxy-headers","--forwarded-allow-ips=*","--limit-concurrency","24"]
